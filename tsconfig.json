{
    "extends": "@tada5hi/tsconfig",
    "compilerOptions": {
        "noEmit": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,

        "lib": ["ESNext", "DOM"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2022"
    },
    "include": ["src", "test"],
    "exclude": ["node_modules"]
}
