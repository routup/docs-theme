{
    "name": "@routup/docs-theme",
    "version": "0.0.0",
    "type": "module",
    "description": "Shared VitePress theme for the routup documentation sites.",
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./config": {
            "types": "./src/config.d.mts",
            "import": "./src/config.mjs",
            "default": "./src/config.mjs"
        },
        "./components/*": "./src/components/*",
        "./style.css": "./src/styles/index.css"
    },
    "files": [
        "src/"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "test": "vitest run --config ./test/vitest.config.ts",
        "lint": "eslint",
        "lint:fix": "npm run lint -- --fix",
        "prepare": "husky"
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "license": "MIT",
    "keywords": [
        "routup",
        "vitepress",
        "vitepress-theme",
        "theme",
        "docs"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/routup/docs-theme.git"
    },
    "bugs": {
        "url": "https://github.com/routup/docs-theme/issues"
    },
    "homepage": "https://github.com/routup/docs-theme#readme",
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0"
    },
    "peerDependencies": {
        "vitepress": "^1.6.0",
        "vue": "^3.5.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@tada5hi/commitlint-config": "^1.3.3",
        "@tada5hi/eslint-config": "^3.3.1",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.11",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "husky": "^9.1.7",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitepress": "^1.6.4",
        "vitest": "^5.1.0",
        "vue": "^3.5.45"
    }
}
